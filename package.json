    "@types/earcut": "^2.1.4",
    "@types/three": "^0.170.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-solid": "^2.10.2"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
